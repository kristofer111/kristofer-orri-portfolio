---
import "../styles/global.css"
import "../styles/connect.css"
---

<section id="connect">
    <div class="section-heading-row">
        <h2>Let's Connect.</h2>
    </div>

    <div class="connect-container">
        <div class="connect-items-container">
            <p class="platform">Email</p>
            <div class="link-and-copy-container">

                <a class="link" href="mailto:kristoferorri1@gmail.com">
                    kristoferorri1@gmail.com
                </a>

                <button class="copy-button" type="button" aria-label="Copy email">
                    <img src="/icons/copy.svg" alt="" />
                </button>

            </div>

        </div>

        <div class="connect-items-container">
            <p class="platform">LinkedIn</p>
            <div class="link-and-copy-container">

                <a
                    class="link"
                    href="https://www.linkedin.com/in/kris-o-svav"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    www.linkedin.com/in/kris-o-svav
                </a>

                <button class="copy-button" type="button" aria-label="Copy email">
                    <img src="/icons/copy.svg" alt="copy icon"/>
                </button>

            </div>
        </div>

        <div class="connect-items-container">
            <p class="platform">GitHub</p>
            <div class="link-and-copy-container">

                <a
                    class="link"
                    href="https://github.com/kristofer111"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    www.github.com/kristofer111
                </a>

                <button class="copy-button" type="button" aria-label="Copy email">
                    <img src="/icons/copy.svg" alt="copy icon"/>
                </button>

            </div>
        </div>

        <div class="connect-items-container">
            <p class="platform">Discord</p>
            <div class="link-and-copy-container">

                <a
                    class="link"
                    href="https://discord.com/users/228613096615313419"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    kristo8849
                </a>

                <button class="copy-button" type="button" aria-label="Copy email">
                    <img src="/icons/copy.svg" alt="copy icon"/>
                </button>

            </div>
        </div>


    </div>
</section>


<script>
import {initCopyButton} from "../scripts/connect";

initCopyButton()
</script>





