---
import "../styles/global.css"
import "../styles/education.css"
---

<section id="education">
    <div class="container">
        <div class="section-heading-row">
            <div class="heading-with-accent">
                <h2>Education.</h2>
            </div>
        </div>

        <div class="education-container">

            <article class="education-item">

                <div class="education-marker">
                    <img class="hr-logo" src="/images/HR_logo_hringur_transparent-cutout1-cutout.png" alt="">
                </div>

                <div class="education-content">

                    <div class="header">
                        <div>
                            <h3 class="school">Reykjavík University</h3>
                            <p class="degree">B.Sc. in Computer Science</p>
                            <p class="emphasis">Emphasis line: Web and Interface Development</p>
                        </div>

                    </div>

                    <p class="dates">
                        2021 – 2026
                    </p>

                    <div class="description-container">
                        <p class="description">
                            I studied CS with the intent of being a frontend developer. I was fascinated by designers
                            like Christie Tang and how to design something that resonates, then bring it to life with code.
                            From there, my fascination spread to nearly every area of CS. I took almost 40% more classes
                            than required because I found everything so interesting.
                        </p>
                    </div>

                </div>

            </article>


            <article class="education-item itu">

                <div class="education-marker">
                    <img src="/images/ITU-logo-orange.png" alt="">
                </div>

                <div class="education-content">

                    <div class="header">
                        <div>
                            <h3 class="school">IT University of Copenhagen</h3>
                            <p class="degree">Exchange studies</p>
                        </div>
                    </div>

                    <p class="dates">
                        2025
                    </p>

                    <div class="description-container">
                        <p class="description">
                            Towards the end of my studies, I went abroad to Copenhagen for a semester where I learned
                            Android app development, functional programming concepts, data visualization, and classical AI.
                        </p>
                    </div>

                </div>

            </article>

        </div>

    </div>
</section>



